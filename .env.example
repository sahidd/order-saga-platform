# Optional. Docker Compose starts with local demo defaults when this file is absent.
# Copy to .env only on your machine. Do not commit .env.

# Leave the model at none unless you want the order service to call a real chat API.
SPRING_AI_MODEL_CHAT=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Tokens are issued for this issuer. Inside Compose the services still fetch keys from Keycloak's container hostname.
APP_JWT_ISSUER=http://localhost:8180/realms/order-saga
APP_JWT_JWK_SET_URI=http://localhost:8180/realms/order-saga/protocol/openid-connect/certs

MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
